# Copy to bot/.env for local runs (see README "Run locally").
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<bot app id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=<bot client secret>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<tenant id>
CONNECTIONSMAP__0__SERVICEURL=*
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION

AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__MCP__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=mcp_sso
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__MCP__SETTINGS__OBOCONNECTIONNAME=SERVICE_CONNECTION

MCP_URL=http://localhost:8000/mcp
MCP_SCOPE=api://<mcp app id>/access_as_user

AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<chat deployment>
# Local only; in Azure the managed identity is used.
# AZURE_OPENAI_API_KEY=
